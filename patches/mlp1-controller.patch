diff --git a/src/input/leaf-keymap.h b/src/input/leaf-keymap.h
new file mode 100644
--- /dev/null
+++ b/src/input/leaf-keymap.h
@@ -0,0 +1,64 @@
+#ifndef LEAF_KEYMAP_H
+#define LEAF_KEYMAP_H
+
+#include <SDL.h>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+// Optional per-game controller-to-keyboard profile for Leaf path cores.
+class LeafKeymap {
+    struct Entry { bool axis; int source, sign; SDL_Scancode key; };
+    std::vector<Entry> entries;
+
+    static char *trim(char *s) {
+        while (*s == ' ' || *s == '\t') ++s;
+        size_t n = std::strlen(s);
+        while (n && (s[n-1] == ' ' || s[n-1] == '\t' || s[n-1] == '\r' || s[n-1] == '\n')) s[--n] = 0;
+        return s;
+    }
+public:
+    bool load(const char *path) {
+        entries.clear();
+        if (!path || !*path) return false;
+        FILE *file = std::fopen(path, "r");
+        if (!file) return false;
+        char line[256];
+        bool valid = true;
+        while (std::fgets(line, sizeof(line), file)) {
+            char *source = trim(line);
+            if (!*source || *source == '#') continue;
+            char *equal = std::strchr(source, '=');
+            if (!equal) { valid = false; break; }
+            *equal++ = 0;
+            source = trim(source);
+            SDL_Scancode key = SDL_GetScancodeFromName(trim(equal));
+            if (key == SDL_SCANCODE_UNKNOWN) { valid = false; break; }
+            int sign = 1;
+            size_t n = std::strlen(source);
+            bool signedAxis = n && (source[n-1] == '+' || source[n-1] == '-');
+            if (signedAxis) { sign = source[n-1] == '-' ? -1 : 1; source[n-1] = 0; }
+            SDL_GameControllerAxis axis = SDL_GameControllerGetAxisFromString(source);
+            if (axis != SDL_CONTROLLER_AXIS_INVALID) {
+                entries.push_back({true, axis, sign, key});
+            } else {
+                SDL_GameControllerButton button = SDL_GameControllerGetButtonFromString(source);
+                if (signedAxis || button == SDL_CONTROLLER_BUTTON_INVALID) { valid = false; break; }
+                entries.push_back({false, button, 1, key});
+            }
+        }
+        if (std::ferror(file)) valid = false;
+        std::fclose(file);
+        if (!valid) entries.clear();
+        return !entries.empty();
+    }
+
+    void apply(const int *axes, const bool *buttons, uint8_t *keys) const {
+        std::memset(keys, 0, SDL_NUM_SCANCODES);
+        for (const Entry &entry : entries) {
+            bool pressed = entry.axis ? axes[entry.source] * entry.sign > 16000 : buttons[entry.source];
+            if (pressed) keys[entry.key] = 1;
+        }
+    }
+};
+#endif
